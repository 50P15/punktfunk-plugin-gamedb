{
	"name": "@sopis/plugin-gamedb",
	"version": "1.0.2",
	"private": false,
	"type": "module",
	"description": "Punktfunk Art & Metadata source: cover search from LizardByte GameDB (IGDB covers), no API key — the cover picker Apollo and Vibepollo use.",
	"license": "MIT OR Apache-2.0",
	"homepage": "https://github.com/50P15/punktfunk-plugin-gamedb#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/50P15/punktfunk-plugin-gamedb.git"
	},
	"bugs": "https://github.com/50P15/punktfunk-plugin-gamedb/issues",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"bin": {
		"punktfunk-plugin-gamedb": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"README.es.md",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"build": "bun build src/index.ts src/cli.ts --target=bun --outdir dist --external effect --external '@punktfunk/*'",
		"prepublishOnly": "bun run build",
		"check": "bunx biome check ."
	},
	"dependencies": {
		"@punktfunk/host": "^0.6.0",
		"@punktfunk/plugin-kit": "^0.15.0",
		"effect": "4.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/bun": "^1.3.0",
		"typescript": "^5.9.3"
	},
	"punktfunk": {
		"schema": 1,
		"id": "gamedb",
		"reads": [],
		"network": true
	},
	"keywords": [
		"punktfunk",
		"plugin",
		"gamedb",
		"igdb",
		"cover-art",
		"game-library"
	],
	"author": "sopis",
	"publishConfig": {
		"access": "public"
	}
}
